using System.Windows.Forms;

namespace AlphaRap
{
    public struct CSVInfo
    {
        public DateTime m_DateTime;
        public DateTime m_AlarmTime;
        public string m_Barcode;
        public string m_nT1;
        public string m_nT2;
        public string m_nT3;
        public string m_nCircleTime;
        public string m_nProcessTime;
        public string m_Data;
        public string m_nStatus;
        public string Type;
        public string Code;
        public string Content;
        public DateTime m_LogTime;
        public string m_UserName;
        public string m_Permission;
        public DateTime m_RunDataTime;
        public string m_InfoDes;      
    }
    
    public class CCSVObj
    {
        private List<CSVInfo> m_csvInfo = null;
        public CCSVObj()
        {
            m_csvInfo = new List<CSVInfo>();
           
        }
        public int ReadAlarmCSV(string strPath)
        {
            if (!File.Exists(strPath))
            {
                return -1;
            }

            string[] strContent = File.ReadAllLines(strPath, Encoding.GetEncoding("GB2312"));
            string[] strTemp = null;
            for (int i = 1; i < strContent.Length; i++)
            {
                strTemp = strContent[i].Split(',');
                if (22 == strTemp.Length)
                {
                    CSVInfo infoLine = new CSVInfo();
                    try
                    {
                        infoLine.m_AlarmTime = DateTime.Parse(strTemp[0]);
                        infoLine.Type = strTemp[1];
                        infoLine.Code = strTemp[2];
                        infoLine.Content = strTemp[3];
                     }
                    catch (Exception ex)
                    {
                        Console.WriteLine(ex.Message);
                        return -2;
                    }
                    m_csvInfo.Add(infoLine);
                }
            }
            return m_csvInfo.Count;
        }
        public int ReadCSV(string strPath)
        {
            if(!File.Exists(strPath))
            {
                return -1;
            }
            string[] strContent = File.ReadAllLines(strPath, Encoding.GetEncoding("GB2312"));
            string[] strTemp = null;
            for(int i=1;i<strContent.Length;i++)
            {
                strTemp = strContent[i].Split(',');
                if(22 == strTemp.Length)
                {
                    CSVInfo infoLine = new CSVInfo();
                    try
                    {
                        infoLine.m_DateTime =DateTime.Parse(strTemp[0]);
                        infoLine.m_Barcode = strTemp[1];
                        infoLine.m_nT1 = strTemp[2];
                        infoLine.m_nT2 = strTemp[3];
                        infoLine.m_nT3 = strTemp[4];
                        infoLine.m_nCircleTime = strTemp[5];
                        infoLine.m_nProcessTime = strTemp[6];
                        infoLine.m_Data = strTemp[7];
                        infoLine.m_nStatus = strTemp[8];
                    }
                    catch(Exception ex)
                    {
                        Console.WriteLine(ex.Message);
                        return -2;
                    }
                    m_csvInfo.Add(infoLine);
                }
            }
            return m_csvInfo.Count;
        }
        public int ReadUserInfo(string strPath)
        {
            if (!File.Exists(strPath))
            {
              return -1;
            }
            string[] strContent = File.ReadAllLines(strPath, Encoding.GetEncoding("GB2312"));
            string[] strTemp = null;
            for (int i = 1; i < strContent.Length; i++)
            {
                strTemp = strContent[i].Split(',');
                if (22 == strTemp.Length)
                {
                    CSVInfo infoLine = new CSVInfo();
                    try
                    {
                        infoLine.m_LogTime = DateTime.Parse(strTemp[0]);
                        infoLine.m_UserName = strTemp[1];
                        infoLine.m_Permission = strTemp[2];                        
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine(ex.Message);
                        return -2;
                    }
                    m_csvInfo.Add(infoLine);
                }
            }
            return m_csvInfo.Count;
         }
        public int ReadRunInfo(string strPath)
        {
            if (!File.Exists(strPath))
            {
                return -1;
            }

            string[] strContent = File.ReadAllLines(strPath,Encoding.GetEncoding("GB2312"));
            string[] strTemp = null;
            for (int i = 1; i < strContent.Length; i++)
            {
                strTemp = strContent[i].Split(',');
                if (22 == strTemp.Length)
                {
                    CSVInfo infoLine = new CSVInfo();
                    try
                    {
                        infoLine.m_RunDataTime = DateTime.Parse(strTemp[0]);
                        infoLine.m_InfoDes = strTemp[1];                       
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine(ex.Message);
                        return -2;
                    }
                    m_csvInfo.Add(infoLine);
                }
            }
            return m_csvInfo.Count;
         }
        public bool ReadFilePatch(string strPath)
        {
            if (!Directory.Exists(strPath))
            {
                return false;
            }
            else
            {
                return true;
            }
        }
        public List<CSVInfo> GetCSVObjs()
        {
            return m_csvInfo;
        }
      
        public void writeCSV(string newPach,string[] strInfo  )
        {
            //创建文件完全路径名称
            string mrPath = string.Format("{0}\\{1}.csv", newPach, DateTime.Now.ToString("yyyy-MM-dd"));//字符串格式化生成一个CSV文件 
                                                                                                        //判断文件流是否存在,不存在创建文件
            if (!System.IO.File.Exists(newPach))
            {
                //创建文件流对向
               
                FileStream fs = new FileStream(newPach, FileMode.Create, FileAccess.Write);
                //创建文件流操作对象,并绑定文件流
                StreamWriter sw = new StreamWriter(fs);
                //创建数据存储对象,并向其中添加数据
                StringBuilder sb = new StringBuilder();
               //sb.Append(strInfo[0]).Append(",").Append(strInfo[1]).Append(",").Append(strInfo[2]).Append(",").Append(strInfo[3]).Append(",").
                //    Append(strInfo[4]).Append(",").Append(strInfo[5]).Append(",").Append(strInfo[6]).Append(",").Append(strInfo[7]).Append(",").
                //    Append(strInfo[8]);
                //将数据写入文件缓冲流中
                //sw.WriteLine(sb);
                sw.Flush();
                sw.Close();
                fs.Close();
            }
            //创建文件流操作对象,并绑定文件,指明文件数据添加模式
            StreamWriter msw = new StreamWriter(newPach, true, Encoding.Default);
            //创建数据存储对象,并向其中添加数据
            StringBuilder msb = new StringBuilder();
            msb.Append(strInfo[0]).Append(",").Append(strInfo[1]).Append(",").Append(strInfo[2]).Append(",").Append(strInfo[3]).Append(",").
                    Append(strInfo[4]).Append(",").Append(strInfo[5]).Append(",").Append(strInfo[6]).Append(",").Append(strInfo[7]).Append(",").
                    Append(strInfo[8]);
            //将数据写入文件流中
            msw.WriteLine(msb);
            msw.Flush();
            msw.Close();
        }
        
