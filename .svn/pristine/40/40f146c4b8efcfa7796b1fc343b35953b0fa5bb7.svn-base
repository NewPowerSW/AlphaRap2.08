				}
			}
		}
		//BacodeScanner
		#region BarcodeScanner
		public TcpipClient BarcodeScanner = new TcpipClient();
		public string strBarcodeResult;
		public void UpdateScannerResult()
		{
			//RefreshDifferentThreadUI(txtBarcodeMes, () => trriggerScanner());
		}
		public static void RefreshDifferentThreadUI(Control control, Action action)
		{
			if (control.InvokeRequired)
			{
				Action refreshUI = new Action(action);
				control.Invoke(refreshUI);
			}
			else
			{
				action.Invoke();
			}
		}
		public void trriggerScanner()
		{
			BarcodeTrigger(true);
			BarcodeScanner.Receive();//BarcodeScanner.IsReceived()
			if (BarcodeScanner.IsReceived())
			{
				SysPara.strBarcodeResult = BarcodeScanner.GetReceiveString().Trim();
				if (SysPara.strBarcodeResult != "")
				{
					//txtBarcodeMes.AppendText(DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss") + ": " + SysPara.strBarcodeResult + "\r\n");
					txtBarcode.Text = SysPara.strBarcodeResult;
					SysPara.ScannerResult = true;
					BarcodeTrigger(false);
					BarcodeScanner.Disconnect();
					RunTM.Restart();
				}
			}
			if (RunTM.IsOn(10000))
			{
				BarcodeTrigger(false);
				NPSDK.Alarm.Show("501");
			}
		}
		public bool ConnectBarcode()
		{
			bool ret = false;
			//bool bBypassBarcode = MiddleLayer.SystemS.GetSettingValue("Pset", "BypassBarcode");
			//if (!bBypassBarcode)
			//{
			string txtIP = MiddleLayer.ParF.GetSettingValue("PSet", "txtIP1") + "." +
						   MiddleLayer.ParF.GetSettingValue("PSet", "txtIP2") + "." +
						   MiddleLayer.ParF.GetSettingValue("PSet", "txtIP3") + "." +
						   MiddleLayer.ParF.GetSettingValue("PSet", "txtIP4");
			BarcodeScanner.IP = txtIP;
			BarcodeScanner.PORT = MiddleLayer.ParF.GetSettingValue("PSet", "Port");
			BarcodeScanner.Connect();
			return ret;
		}
		public bool BarcodeTrigger(bool State)
		{
			// ConnectBarcode();
			bool ret = false;
			if (!BarcodeScanner.IsConnected())
			{
				ret = ConnectBarcode();
			}
			if (State)
			{
				ret = true;
				BarcodeScanner.Send("LON\r");
			}
			else
			{
				BarcodeScanner.Send("LOFF\r");
			}
			//BarcodeScanner.Receive();
			return ret;
		}

		public void DisconnectBarcode()
		{
			bool bBypassBarcode = MiddleLayer.SystemS.GetSettingValue("Pset", "BypassBarcode");
			if (!bBypassBarcode)
			{
				if (BarcodeScanner.IsConnected())
				{
					BarcodeScanner.Disconnect();
				}
			}
		}

		public bool BarcodeReaderIsConnected()
		{
			return BarcodeScanner.IsConnected();
		}

		#region 1.2 初始化加载点位事件
		private void HomeForm_Load(object sender, EventArgs e)
		{
			MiddleLayer.OpenRecipe(SysPara.FilePath);
			GetProductDataINI();

			timer1.Enabled = true;

			
			MiddleLayer.LockForm1.LanguageChange(SysPara.LanguageShow);

			MiddleLayer.ManualF.OB_LEDLight.On();
			this.btLight.BackColor = Color.Lime;
			a++;
			
			SHOWINITIAL();


		}




