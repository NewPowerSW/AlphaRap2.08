		int a = 1;
		//照明灯
		private void btLight_Click(object sender, EventArgs e)
		{
			if (a == 1)
			{
				this.btLight.BackColor = Color.Lime;
				MiddleLayer.ManualF.OB_LEDLight.On();

				a++;
			}
			else
			{
				this.btLight.BackColor = Color.Silver;
				MiddleLayer.ManualF.OB_LEDLight.Off();

				a = 1;
			}






		}
		int b = 0;
		//直通
		private void btByPass_Click(object sender, EventArgs e)
		{

			if (b == 1)
			{
				SysPara.bByPass = false;
				b = 0;
			}
			else
			{

				DialogResult reult = MessageBox.Show("是否直通模式?", "Warning", MessageBoxButtons.YesNo, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button1, MessageBoxOptions.DefaultDesktopOnly);

				if ((reult == DialogResult.Yes))
				{
					SysPara.bByPass = true;
					b = 1;
				}
			}
		}
		private void timer1_Tick(object sender, EventArgs e)
		{

			#region BYPASS
			if (SysPara.bByPass)
			{
				this.btByPass.BackColor = Color.Lime;
			}
			else
			{
				this.btByPass.BackColor = Color.Silver;
			}

			if (MiddleLayer.alTask.BuzzerNeedWork && !MiddleLayer.SystemS.GetSettingValue("MSet", "UserBuzzer"))
			{
				Buzzer.BackColor = Color.Lime;
			}
			else
			{
				Buzzer.BackColor = Color.Silver;
			}
			#endregion
			#region Door
			bool DoorStaus = MiddleLayer.SystemS.GetSettingValue("MSet", "UserDoor");

			btDoor.BackColor = DoorStaus ? Color.Lime : Color.Silver;



			//if (MiddleLayer.ManualF.OB_DoorPeningAuthority.Ouput_On())
			//{
			//    btDoor.BackColor = Color.Lime;
			//}
			//else
			//{
			//    btDoor.BackColor = Color.Silver;
			//}


			//if (MiddleLayer.ManualF.OB_DoorPeningAuthority.Ouput_On())
			//{

			//    label39.BackColor = Color.LimeGreen;
			//    label39.Text = "Auto";
			//    AutoIndex = 1;
			//}
			//else
			//{
			//    label39.BackColor = Color.Silver;
			//    label39.Text = "Manual";
			//    AutoIndex = 0;
			//}

			#endregion

			#region KEYBORD
			IntPtr _ControlIntPtr = GetFocus();
			if (_ControlIntPtr != IntPtr.Zero)
			{
				Control _Control = Control.FromChildHandle(_ControlIntPtr);
				if (_Control != null)
				{
					Control _gControl = _Control;
					var retval = new Point(0, 0);
					for (; _gControl.Parent != null; _gControl = _gControl.Parent)
					{
						retval.Offset(_gControl.Location);
						if (_gControl.Name == MiddleLayer.MainF.forkeybord.Name)
						{
							break;
						}
					}

					bool MOUSEXY = ppt.X > retval.X && ppt.X < (retval.X + _Control.Width) && ppt.Y > retval.Y && ppt.Y < (retval.Y + _Control.Height);
					if ((_Control.GetType() == typeof(TextBox) || _Control.GetType() == typeof(DataGridViewTextBoxEditingControl) || _Control.GetType() == typeof(NPSDK.Keyence.Keyence_Text)) && MOUSEXY)
					{
						if (System.Diagnostics.Process.GetProcessesByName("osk").Length == 0 && System.IO.File.Exists(@"C:\Windows\system32\osk.exe"))
						{
							try
							{
								System.Diagnostics.Process.Start(@"C:\Windows\system32\osk.exe");
							}
							catch { }
						}
					}
					else
					{
						if (System.Diagnostics.Process.GetProcessesByName("osk").Length > 0)
						{
							Process[] a = System.Diagnostics.Process.GetProcessesByName("osk");
							foreach (Process b in a)
							{
								try
								{
									//  b.Kill();
								}
								catch
								{ }
							}
						}
					}
				}
			}
			#endregion
			#region Alarm Message
			MiddleLayer.HomeF.AlarmMessageLangLanguage(SysPara.LanguageShow);
			if (NPSDK.Alarm.DoRefresh)
			{
				NPSDK.Alarm.DoRefresh = false;
				WarnningMessage.BeginUpdate();
				WarnningMessage.Items.Clear();
				for (int i = 0; i < NPSDK.Alarm.AlarmList.Count; i++)
				{
					NPSDK.Alarm.AlarmDataClass AlarmData = NPSDK.Alarm.AlarmList[i];
					string DateT = DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss");
					// ListViewItem Alarm = new ListViewItem(AlarmData.DateTime); 
					ListViewItem Alarm = new ListViewItem(DateT);

					Alarm.SubItems.Add(AlarmData.Type);
					Alarm.SubItems.Add(AlarmData.Code);
					Alarm.SubItems.Add(AlarmData.Content);

					string _RECIPEID = MiddleLayer.ProductF.GetRecipeValue("ProductSetting", "RECIPEID");
					string[] data = new string[8];

					data[0] = SysPara.UserName;
					data[1] = _RECIPEID;
					data[2] = SysPara.RecipeName;
					data[3] = (SysPara.SystemMode == RunMode.RUN || SysPara.SystemMode == RunMode.PAUSE) ? "Auto" : "Manual";

					data[4] = AlarmData.Type == "E" ? "ERROR" : "Information";
					data[5] = AlarmData.Code;
					data[6] = AlarmData.Content;
					switch (AlarmData.Type)
					{
						case "E":

							if (SysPara.SystemRun)
							{
								MiddleLayer.DataF.Alarm.SaveDataToFile(data);
								DateTime TWriteLogTime = DateTime.Now;

								MiddleLayer.PauseRun();


							}
							Alarm.SubItems[0].BackColor = Color.Red;



							break;
						case "W":

							Alarm.SubItems[0].BackColor = Color.DarkSalmon;
							break;

					}


					WarnningMessage.Items.Add(Alarm);

					//MiddleLayer.LogF.AddLog(LogType.Alarm, ArmData.Type + "," + ArmData.Code + "," + ArmData.Content);
				}
				WarnningMessage.EndUpdate();
				WriteExcelData();
				//ListViewWrite.WriteExcelData("D:\\Log\\AlarmMessageData\\", lvMessage, Alarm1);
			}
			#endregion


			#region Machine Status 
			switch (SysPara.LanguageShow)
			{
				case LanguageType.Chinese:
					break;
				case LanguageType.English:
					break;
			}
			if (SysPara.SystemMode == RunMode.IDLE && SysPara.LanguageShow == LanguageType.Chinese)
			{
				MachineStatus.BackColor = Color.Yellow;
				MachineStatus.Text = "待机状态";
				MiddleLayer.ManualF.OB_StartButton_Light.Off();
				MiddleLayer.ManualF.OB_StoptButton_Light.On();


			}
			else if (SysPara.SystemMode == RunMode.IDLE && SysPara.LanguageShow == LanguageType.English)
			{
				MachineStatus.BackColor = Color.Yellow;
				MachineStatus.Text = "IDLE";
				MiddleLayer.ManualF.OB_StartButton_Light.Off();
				MiddleLayer.ManualF.OB_StoptButton_Light.On();

			}

			if (SysPara.SystemMode == RunMode.INITIAL && !SysPara.ConveyorInitialOk && SysPara.LanguageShow == LanguageType.Chinese)
			{
				MachineStatus.BackColor = Color.Yellow;
				MachineStatus.Text = "正在初始化状态";

				MiddleLayer.ManualF.OB_StartButton_Light.On();
				MiddleLayer.ManualF.OB_StoptButton_Light.Off();
			}
			else if (SysPara.SystemMode == RunMode.INITIAL && !SysPara.ConveyorInitialOk && SysPara.LanguageShow == LanguageType.English)
			{
				MachineStatus.BackColor = Color.Yellow;
				MachineStatus.Text = "INITIAL";

				MiddleLayer.ManualF.OB_StartButton_Light.On();
				MiddleLayer.ManualF.OB_StoptButton_Light.Off();

			}

			if (SysPara.SystemMode == RunMode.INITIAL && SysPara.ConveyorInitialOk && SysPara.LanguageShow == LanguageType.Chinese)
			{
				MachineStatus.BackColor = Color.Yellow;
				MachineStatus.Text = "初始化完成";

				MiddleLayer.ManualF.OB_StartButton_Light.Off();
				MiddleLayer.ManualF.OB_StoptButton_Light.On();

			}
			else if (SysPara.SystemMode == RunMode.INITIAL && SysPara.ConveyorInitialOk && SysPara.LanguageShow == LanguageType.English)
			{
				MachineStatus.BackColor = Color.Yellow;
				MachineStatus.Text = "INITIAL Completed";

				MiddleLayer.ManualF.OB_StartButton_Light.Off();
				MiddleLayer.ManualF.OB_StoptButton_Light.On();
			}

			if (SysPara.SystemMode == RunMode.RUN && SysPara.LanguageShow == LanguageType.Chinese)
			{
				MachineStatus.BackColor = Color.Lime;
				MachineStatus.Text = "运行状态";

				MiddleLayer.ManualF.OB_StartButton_Light.On();
				MiddleLayer.ManualF.OB_StoptButton_Light.Off();
			}
			else if (SysPara.SystemMode == RunMode.RUN && SysPara.LanguageShow == LanguageType.English)
			{
				MachineStatus.BackColor = Color.Lime;
				MachineStatus.Text = "RUNNING";

				MiddleLayer.ManualF.OB_StartButton_Light.On();
				MiddleLayer.ManualF.OB_StoptButton_Light.Off();
			}

			if (SysPara.SystemMode == RunMode.PAUSE && SysPara.LanguageShow == LanguageType.Chinese)
			{
				MachineStatus.BackColor = Color.Red;
				MachineStatus.Text = "暂停状态";

				MiddleLayer.ManualF.OB_StartButton_Light.Off();
				MiddleLayer.ManualF.OB_StoptButton_Light.On();
			}
			else if (SysPara.SystemMode == RunMode.PAUSE && SysPara.LanguageShow == LanguageType.English)
			{
				MachineStatus.BackColor = Color.Red;
				MachineStatus.Text = "PAUSE";

				MiddleLayer.ManualF.OB_StartButton_Light.Off();
				MiddleLayer.ManualF.OB_StoptButton_Light.On();
			}
			
			#endregion


			DateTime datanow = DateTime.Now;


			txtCT.Text = SysPara.CircleTime + "/s";


			if ((SysPara.iProductOK + SysPara.iProductNG).ToString() != txtPTotal.Text)
			{
				MiddleLayer.SpanLifeF.TimeAdd();


				SysPara.iProductHourlyInput[datanow.Hour] += 1;
			}

			if (txtPOK.Text != SysPara.iProductOK.ToString())
			{
				MiddleLayer.HomeF.hoursProductShow1.kPointAdd(DateTime.Now, (int)(SysPara.iProductOK - Convert.ToInt32(txtPOK.Text)), true);
				MiddleLayer.HomeF.hoursProductShow1.AllTimeDataShow(DateTime.Now);

				SysPara.iProductHourlyOutput[datanow.Hour] += SysPara.iProductOK - Convert.ToInt32(txtPOK.Text);
			}

			if (txtPNG.Text != SysPara.iProductNG.ToString())
			{
				MiddleLayer.HomeF.hoursProductShow1.kPointAdd(DateTime.Now, (int)(SysPara.iProductNG - Convert.ToInt32(txtPNG.Text)), false);
				MiddleLayer.HomeF.hoursProductShow1.AllTimeDataShow(DateTime.Now);
				SysPara.iProductHourlyReject[datanow.Hour] += SysPara.iProductNG - Convert.ToInt32(txtPNG.Text);
			}

			GetProductData();

			if (SysPara.UserPermission == PermissionType.Operator)
			{
				btDoor.Enabled = false;
				btByPass.Enabled = false;
				btClearCount.Enabled = false;
				// ClearData.Enabled = false;
			}
			else
			{
				btDoor.Enabled = true;
				btByPass.Enabled = true;
				btClearCount.Enabled = true;
				// ClearData.Enabled = true;
			}
			string log = NPFlowChart.Flow_Module.Module_GetRunLog();
			if (log != "")
			{
				AddRunMessage(log);

			}

		}



		private void GetProductDataINI()
		{

			DateTime datanow = DateTime.Now;


			MiddleLayer.HomeF.hoursProductShow1.GetHourShift(DateTime.Now, ref HourInputShift, ref HourOutputShift, ref HourRejectShift, ref HourYeild);
			MiddleLayer.HomeF.hoursProductShow1.GetAllShift(DateTime.Now, ref AllInputShift, ref AllOutputShift, ref AllRejectShift, ref AllYeild);


			tHourlyInput.Text = HourInputShift.ToString();
			tHourlyOutput.Text = HourOutputShift.ToString();
			tHourlyReject.Text = HourRejectShift.ToString();
			tHourlyYield.Text = HourYeild.ToString("F2");


			txtPTotal.Text = AllInputShift.ToString();
			txtPOK.Text = AllOutputShift.ToString();
			txtPNG.Text = AllRejectShift.ToString();
			txtPRatio.Text = AllYeild.ToString("F2"); ;
			SysPara.iProductOK = AllOutputShift;
			SysPara.iProductNG = AllRejectShift;

		}

		private void GetProductData()
		{

			DateTime datanow = DateTime.Now;


			MiddleLayer.HomeF.hoursProductShow1.GetHourShift(DateTime.Now, ref HourInputShift, ref HourOutputShift, ref HourRejectShift, ref HourYeild);
			MiddleLayer.HomeF.hoursProductShow1.GetAllShift(DateTime.Now, ref AllInputShift, ref AllOutputShift, ref AllRejectShift, ref AllYeild);


			tHourlyInput.Text = HourInputShift.ToString();
			tHourlyOutput.Text = HourOutputShift.ToString();
			tHourlyReject.Text = HourRejectShift.ToString();
			tHourlyYield.Text = HourYeild.ToString("F2");


			txtPTotal.Text = AllInputShift.ToString();
			txtPOK.Text = AllOutputShift.ToString();
			txtPNG.Text = AllRejectShift.ToString();
			txtPRatio.Text = AllYeild.ToString("F2"); ;
			SysPara.iProductOK = AllOutputShift;
			SysPara.iProductNG = AllRejectShift;

		}


