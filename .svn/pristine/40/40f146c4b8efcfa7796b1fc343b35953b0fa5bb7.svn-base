		private void SHOWINITIAL()
		{

			DataINITIAL(dataGridView_load1, 2, 1);
			DataINITIAL(dataGridView_load2, 2, 1);

			SetCellValue(dataGridView_load1, 0, 0, "1");
			SetCellValue(dataGridView_load1, 1, 0, "2");
			SetCellValue(dataGridView_load2, 0, 0, "1");
			SetCellValue(dataGridView_load2, 1, 0, "2");


			DataINITIAL(Table_1, 1, 2);
			SetCellValue(Table_1, 0, 0, "1");
			SetCellValue(Table_1, 0, 1, "2");

			DataINITIAL(Table_2, 2, 1);
			SetCellValue(Table_2, 0, 0, "1");
			SetCellValue(Table_2, 1, 0, "2");


			DataINITIAL(Table_3, 2, 1);
			SetCellValue(Table_3, 0, 0, "1");
			SetCellValue(Table_3, 1, 0, "2");


			DataINITIAL(Table_4, 2, 1);
			SetCellValue(Table_4, 0, 0, "1");
			SetCellValue(Table_4, 1, 0, "2");

			DataINITIAL(Table_5, 1, 2);
			SetCellValue(Table_5, 0, 0, "2");
			SetCellValue(Table_5, 0, 1, "1");

			DataINITIAL(Table_6, 2, 1);
			SetCellValue(Table_6, 0, 0, "2");
			SetCellValue(Table_6, 1, 0, "1");

			DataINITIAL(Table_7, 2, 1);
			SetCellValue(Table_7, 0, 0, "2");
			SetCellValue(Table_7, 1, 0, "1");

			DataINITIAL(Table_8, 2, 1);
			SetCellValue(Table_8, 0, 0, "2");
			SetCellValue(Table_8, 1, 0, "1");


			DataINITIAL(dataGridView_unload1, 1, 2);
			DataINITIAL(dataGridView_unload2, 1, 2);

			SetCellValue(dataGridView_unload1, 0, 0, "2");
			SetCellValue(dataGridView_unload1, 0, 1, "1");
			SetCellValue(dataGridView_unload2, 0, 0, "2");
			SetCellValue(dataGridView_unload2, 0, 1, "1");

			DataINITIAL(dataGridView_PCBTray, 5, 2);
			DataINITIAL(dataGridView_UnloadTray, 5, 5);
			DataINITIAL(dataGridView_NGTray, 3, 2);

			for (int i = 0; i < dataGridView_PCBTray.RowCount; i++)
			{

				for (int j = 0; j < dataGridView_PCBTray.ColumnCount; j++)
				{

					SetCellValue(dataGridView_PCBTray, dataGridView_PCBTray.RowCount - i - 1, j, (i + 1).ToString() + (j + 1).ToString());

				}

			}


			for (int i = 0; i < dataGridView_UnloadTray.RowCount; i++)
			{

				for (int j = 0; j < dataGridView_UnloadTray.ColumnCount; j++)
				{

					SetCellValue(dataGridView_UnloadTray, dataGridView_UnloadTray.RowCount - i - 1, dataGridView_UnloadTray.ColumnCount - j - 1, (i + 1).ToString() + (j + 1).ToString());

				}

			}

			for (int i = 0; i < dataGridView_NGTray.RowCount; i++)
			{

				for (int j = 0; j < dataGridView_NGTray.ColumnCount; j++)
				{

					SetCellValue(dataGridView_NGTray, dataGridView_NGTray.RowCount - i - 1, dataGridView_NGTray.ColumnCount - j - 1, ((3 - i) + (1 - j) * 3).ToString()/*(i).ToString() + (j).ToString()*/);

				}

			}




			for (int i = 0; i < MiddleLayer.HomeF.dataGridView_NGTray.RowCount; i++)
			{

				for (int j = 0; j < MiddleLayer.HomeF.dataGridView_NGTray.ColumnCount; j++)
				{

					MiddleLayer.HomeF.SetCellColor(MiddleLayer.HomeF.dataGridView_NGTray, i, j, Color.White);
				}

			}

		}


		public void DataINITIAL(DataGridView Position, int RowIndex, int Columns)

		{


			Position.Rows.Clear();

			Position.RowCount = RowIndex;
			Position.ColumnCount = Columns;

			// Position.Columns[0].Width = (Position.Width- Position.RowHeadersWidth)/ 2;




			for (int i = 0; i < Columns; i++)
			{
				Position.Columns[i].Width = (Position.Width) / Columns;
				Position.Columns[i].HeaderCell.Value = (i + 1).ToString();


			}

			for (int i = 0; i < RowIndex; i++)
			{
				Position.Rows[i].Height = (Position.Height) / RowIndex;
				Position.Rows[i].HeaderCell.Value = (i + 1).ToString();
				Position.Rows[i].Cells[0].Value = "";


			}

			Position.ClearSelection();


		}


		public void SetCellColor(DataGridView Position, int RowIndex, int Columns, Color CellColor)
		{
			Position[Columns, RowIndex].Style.BackColor = CellColor;

		}

		public void SetCellValue(DataGridView Position, int RowIndex, int Columns, string CellValue)
		{
			Position[Columns, RowIndex].Value = CellValue;

		}

		
		
		public  string  GetAlarmConent(string Index)
		{
			DataTable dtTable = new DataTable();
			List<string> mlist;
			dtTable.Rows.Clear();
			AlphaRap.srvConfigReadWriteXML srv = new AlphaRap.srvConfigReadWriteXML();
			
			System.Xml.XmlDocument _xmlDoc = SysPara.LanguageShow== LanguageType.English? srv.XmlDocumentLoad(System.Windows.Forms.Application.StartupPath + "\\AlarmTable\\English.xml"):srv.XmlDocumentLoad(System.Windows.Forms.Application.StartupPath + "\\AlarmTable\\Chinese.xml");
			string strInnerXml = _xmlDoc.FirstChild.InnerXml;
			if (strInnerXml.Trim().Length > 0)
			{
				mlist = strInnerXml.Trim().Replace("/><", "/>\n<").Split('\n').ToList();
				foreach (string forRor in mlist)
				{
					string strValue = forRor.Substring(2, forRor.IndexOf(' ') - 1);
					string strIndexOf = "Content=\"";
					int iIndex = forRor.IndexOf(strIndexOf) + strIndexOf.Trim().Length;
					string strContent = forRor.Substring(iIndex, forRor.Trim().Length - iIndex);
					strContent = strContent.Substring(0, strContent.IndexOf('\"'));
					if(string.Equals(strValue.Trim(), Index.Trim()))
					{
						return strContent;
					}
				}
			}
			return "Error";
		}
		private void button1_Click_1(object sender, EventArgs e)
		{

			MiddleLayer.HomeF.AddErrorLog("Alarm:" + MiddleLayer.HomeF.GetAlarmConent("1") + "- " + "Position:" + "ConveyInit_Flow1_05");


		}
	}
	
