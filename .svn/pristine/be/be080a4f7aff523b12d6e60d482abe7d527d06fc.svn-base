	class AlwaysRunTask
	{
		private bool StatusChange_Start = false;
		private bool StatusChange_Stop = false;
		private bool StatusChange_Emergency = false;
		private JTimer BlinkTM = new JTimer();
		private bool BlinkIsOn = false;
		private const int BlinkTime = 500;
		public bool BuzzerNeedWork = true;

		Thread FlowControlThread = null;

		public AlwaysRunTask()
		{

		}

		public void StartAlwaysRun()
		{
			FlowControlThread = new Thread(AlwaysRunWork);
			FlowControlThread.Start();
		}

		public void AlwaysRunWork()
		{
			while (!MiddleLayer.gEXIT)
			{
				AlwaysRun();
			}
		}
		public void AlwaysRun()
		{
			
			if (SysPara.Simulation)
				return;

			#region BlinkTimer
			if (BlinkTM.IsOn(BlinkTime))
			{
				BlinkIsOn = !BlinkIsOn;
				BlinkTM.Restart();
			}
			#endregion

			#region MaintainMode Scan
			//SysPara.IsMaintenanceMode = MiddleLayer.ManualF.IB_ManualMode.IsOn();
			//if (!SysPara.IsMaintenanceMode)
			//{
			//    if (!StatusChange_ModeSwitch)
			//    {

			//        StatusChange_ModeSwitch = true;
			//        MiddleLayer.PauseRun();
			//        MiddleLayer.ManualF.OB_DoorPeningAuthority.On();
			//        MiddleLayer.SetLowSpeed();
			//    }

			//}
			//else
			//{
			//    if (StatusChange_ModeSwitch)
			//    {
			//        MiddleLayer.PauseRun();
			//        StatusChange_ModeSwitch = false;
			//        MiddleLayer.ManualF.OB_DoorPeningAuthority.Off();
			//        MiddleLayer.SetHightSpeed();

			//    }

			//}

			#endregion

			#region Ready Scan
			if (!MiddleLayer.ManualF.IB_SafetyReady.On())
			{


				NPSDK.Alarm.Show("3024", SysPara.LanguageShow == LanguageType.Chinese ? "请按复位按钮上电" : "Please button Reset button to power on");
			}
			else
			{


			}
			#endregion


			#region Emergency Stop Scan
			if (!MiddleLayer.ManualF.IB_Front_EmergencyStop.On())
			{
				if (StatusChange_Emergency)
				{
					MiddleLayer.StopRun();

					SysPara.SystemRun = false;
					SysPara.SystemMode = RunMode.IDLE;
					SysPara.UpConveyorInitialOk = false;
					StatusChange_Emergency = false;
					MiddleLayer.DataF.AddLogError(LogManagement.LogType.Operation + $"{SysPara.UserName}Front_EmergencyStop is On");
				}

				NPSDK.Alarm.Show("3021");
			}
			else
			{

				if (!StatusChange_Emergency)
					StatusChange_Emergency = true;
			}
			#endregion

			#region Emergency2 Stop Scan
			if (!MiddleLayer.ManualF.IB_Back_EmergencyStop.On())
			{
				if (StatusChange_Emergency)
				{
					MiddleLayer.StopRun();

					SysPara.SystemRun = false;
					SysPara.SystemMode = RunMode.IDLE;
					SysPara.UpConveyorInitialOk = false;
					StatusChange_Emergency = false;

				}
				NPSDK.Alarm.Show("3022");
			}
			else
			{

				if (!StatusChange_Emergency)
					StatusChange_Emergency = true;
			}
			#endregion

			#region BackSafety door Scan

			//if (!MiddleLayer.ManualF.IB_BackSlideDoorOpen.Input())
			//{

			//    if (SysPara.SystemMode == RunMode.RUN || (SysPara.SystemMode == RunMode.INITIAL && !SysPara.UpConveyorInitialOk))
			//    {

			//        if (!StatusChange_BackSafetyDoor)
			//        {
			//            MiddleLayer.ManualF.OB_FluorescentLight.Ouput_On();
			//            MiddleLayer.HomeF.btLight.BackColor = Color.Lime;
			//            StatusChange_BackSafetyDoor = true;
			//        }

			//        if (MiddleLayer.SystemS.GetSettingValue("MSet", "UserDoor"))
			//        {
			//            MiddleLayer.PauseRun();
			//            NPSDK.Alarm.Show("3027");
			//        }
			//        else
			//        {
			//            NPSDK.Alarm.Show("3043");
			//        }


			//    }

			//}
			//else
			//{
			//    if (StatusChange_BackSafetyDoor)
			//    {
			//        // NPSDK.Alarm.Clear();
			//        MiddleLayer.ManualF.OB_FluorescentLight.Ouput_On();
			//        StatusChange_BackSafetyDoor = false;
			//        MiddleLayer.HomeF.btLight.BackColor = Color.Silver;
			//    }
			//}
			#endregion
			#region FrontSafety door Scan
			//if (MiddleLayer.ManualF.IB_FrontSlideDoorOpen.Input())
			//{
			//    if (!StatusChange_FrontBackSafetyDoor)
			//    {
			//        MiddleLayer.ManualF.OB_FluorescentLight.Ouput_On();
			//        MiddleLayer.HomeF.btLight.BackColor = Color.Lime;
			//        StatusChange_FrontBackSafetyDoor = true;
			//    }

			//    if (!MiddleLayer.SystemS.GetSettingValue("MSet", "UserDoor"))
			//    {
			//        MiddleLayer.PauseRun();
			//        NPSDK.Alarm.Show("3026");
			//    }
			//    else
			//    {
			//        NPSDK.Alarm.Show("3043");
			//    }

			//}
			//else
			//{
			//    if (StatusChange_FrontBackSafetyDoor)
			//    {
			//        // NPSDK.Alarm.Clear();
			//        MiddleLayer.ManualF.OB_FluorescentLight.Ouput_On();
			//        StatusChange_FrontBackSafetyDoor = false;
			//        MiddleLayer.HomeF.btLight.BackColor = Color.Silver;
			//    }
			//}
			#endregion


			#region Start Button Scan
			if (MiddleLayer.ManualF.IB_StartButton.On())
			{
				if (!StatusChange_Start && MiddleLayer.MainF.MENU_Run.Enabled)
				{

					MiddleLayer.StartRun();
					StatusChange_Start = true;
				}
			}
			else
			{
				if (StatusChange_Start)
					StatusChange_Start = false;
			}
			#endregion

			#region Stop Button Scan
			if (MiddleLayer.ManualF.IB_StopButton.On())
			{
				if (!StatusChange_Stop)
				{

					MiddleLayer.PauseRun();
					StatusChange_Stop = true;
				}
			}
			else
			{
				if (StatusChange_Stop)
					StatusChange_Stop = false;
			}
			#endregion

			#region Alarm Reset Button Scan
			if (MiddleLayer.ManualF.IB_ResetButton.On())
			{
				MiddleLayer.AlarmClear();
				Thread.Sleep(100);
			}

			#endregion

			#region Signal Tower ControlSysPara.SystemRun
			if (SysPara.SystemRun)
			{
				if (NPSDK.Alarm.IsWarning)
					MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MessageWarning);
				else if (NPSDK.Alarm.IsInformation)
					MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MessageInformation);
				else if (NPSDK.Alarm.IsError)
				{
					if (SysPara.SystemMode == RunMode.RUN)
						MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MachineRunning);
					if (SysPara.SystemMode == RunMode.INITIAL)
						MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MachineInitialize);
					if (SysPara.SystemMode == RunMode.PAUSE)
						MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MessageError);
				}

				else
				{
					if (SysPara.SystemMode == RunMode.RUN)
						MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MachineRunning);
					if (SysPara.SystemMode == RunMode.INITIAL)
						MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MachineInitialize);
					if (SysPara.SystemMode == RunMode.PAUSE)
						MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MessageWarning);
				}
			}
			else
			{
				//NPSDK.Alarm.IsError
				if (NPSDK.Alarm.IsError)
					MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MessageError);
				else
				{
					if (SysPara.SystemMode == RunMode.IDLE)
						MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MachineIdle);
					if (SysPara.SystemMode == RunMode.INITIAL)
						MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MachineInitialize);
					if (SysPara.SystemMode == RunMode.PAUSE)
						MiddleLayer.CheckF.SwitchSignalTowerStatus(SignalTowerStatusType.MessageWarning);
				}
			}

			// Refresh Output Status

			Control_SignalTower(MiddleLayer.CheckF.GreenLightStatus, MiddleLayer.ManualF.OB_GreenLight);
			Control_SignalTower(MiddleLayer.CheckF.YellowLightStatus, MiddleLayer.ManualF.OB_YellowLight);
			Control_SignalTower(MiddleLayer.CheckF.RedLightStatus, MiddleLayer.ManualF.OB_RedLight);

			if (BuzzerNeedWork && !MiddleLayer.SystemS.GetSettingValue("MSet", "UserBuzzer"))// !GetSettingValue("PSet", "DisableSafetyBuzzer")
			{

				Control_SignalTower(MiddleLayer.CheckF.BuzzerStatus, MiddleLayer.ManualF.OB_Buzz);
			}

			#endregion

			#region lifeSpan
			//try
			//{
			//    MiddleLayer.SpanLifeF.GetAlarm();
			//    for (int i = 0; i < MiddleLayer.SpanLifeF.alarm.Count; i++)
			//    {
			//        NPSDK.Alarm.Show((10000 + i).ToString(), MiddleLayer.SpanLifeF.alarm[i]);
			//    }
			//}
			//catch { }
			#endregion
			#region Air Pressure Scan
			if (!MiddleLayer.ManualF.IB_Air.On())
			{


				NPSDK.Alarm.Show("3041");
			}

			#endregion


		}

		public static void RefreshDifferentThreadUI(Control control, Action action)
		{
			if (control.InvokeRequired)
			{
				Action refreshUI = new Action(action);
				control.Invoke(refreshUI);
			}
			else
			{
				action.Invoke();
			}
		}


		private void Control_SignalTower(Status status, NPSDK.Adlink_Output OB)
		{
			switch (status)
			{
				case Status.Off:
					OB.Off();
					break;
				case Status.On:
					OB.On();
					break;
				case Status.Blink:
					if (BlinkIsOn)
					{
						OB.On();

					}

					else
					{
						OB.On();
					}

					break;
			}
		}

		public void BuzzOff()
		{
			if (BuzzerNeedWork)
			{
				BuzzerNeedWork = false;
				MiddleLayer.ManualF.OB_Buzz.On();

			}
			else
			{

				BuzzerNeedWork = true;

			}

		}
	}
}
