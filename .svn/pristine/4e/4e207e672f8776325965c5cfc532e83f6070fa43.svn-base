        private void radioButton1_CheckedChanged(object sender, EventArgs e)
        {

        }
        /// <summary>
        /// 用户登录信息路径
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        private void button3_Click(object sender, EventArgs e)
        {
            FolderBrowserDialog dilog = new FolderBrowserDialog();
            dilog.Description = "Please select the Panel Save folder";
            if (dilog.ShowDialog() == DialogResult.OK)
            {
                txtUser.Text = dilog.SelectedPath;
                txtUser.Focus();
                // SysPara.UserMessagePath = txtUser.Text + "\\";
            }
            SysPara.items++;
        }
        /// <summary>
        /// 设备运行信息路径
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        private void btRunMessagePath_Click(object sender, EventArgs e)
        {
            FolderBrowserDialog dilog = new FolderBrowserDialog();
            dilog.Description = "Please select the Panel Save folder";
            if (dilog.ShowDialog() == DialogResult.OK)
            {
                txtRun.Text = dilog.SelectedPath;
                //  SysPara.RunMessagePath = textBox8.Text+"\\";
                txtRun.Focus();
            }
            SysPara.items++;
        }
        /// <summary>
        /// 产品信息路径
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        private void button4_Click(object sender, EventArgs e)
        {
            FolderBrowserDialog dilog = new FolderBrowserDialog();
            dilog.Description = "Please select the Panel Save folder";
            if (dilog.ShowDialog() == DialogResult.OK || dilog.ShowDialog() == DialogResult.Yes)
            {
                txtProduct.Text = dilog.SelectedPath;
                txtProduct.Focus();
            }
            SysPara.items++;
        }
