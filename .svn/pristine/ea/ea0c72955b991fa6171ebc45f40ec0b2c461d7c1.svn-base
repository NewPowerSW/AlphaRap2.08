<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/WNC.SFCS.DTO.Enum" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/WNC.SFCS.DTO.Enum" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="DataType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="JSON" />
      <xs:enumeration value="XML" />
      <xs:enumeration value="TEXT" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="DataType" nillable="true" type="tns:DataType" />
  <xs:simpleType name="MsgFuncType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SendNoReply" />
      <xs:enumeration value="PrevProcessCheck" />
      <xs:enumeration value="ProcessStart" />
      <xs:enumeration value="ProcessComplete" />
      <xs:enumeration value="Alarm" />
      <xs:enumeration value="Trace" />
      <xs:enumeration value="Event" />
      <xs:enumeration value="CallOut" />
      <xs:enumeration value="Bind" />
      <xs:enumeration value="Unbind" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="MsgFuncType" nillable="true" type="tns:MsgFuncType" />
  <xs:simpleType name="ActionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Delete" />
      <xs:enumeration value="Modify" />
      <xs:enumeration value="Add" />
      <xs:enumeration value="Query" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="ActionType" nillable="true" type="tns:ActionType" />
  <xs:simpleType name="MaintainType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Maintain" />
      <xs:enumeration value="Change" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="MaintainType" nillable="true" type="tns:MaintainType" />
</xs:schema>