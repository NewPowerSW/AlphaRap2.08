	public partial class Converyor : NPFlowChart.Flow_BaseForm
	{
		public Converyor()
		{
			CheckForIllegalCrossThreadCalls = false;
			InitializeComponent();
		}
		public override void Initial()
		{
			ConveyInit_Flow1_1.FlowChart_Run();

		}
		public override void PauseRun()
		{

		}
		public override void StartRun()
		{
			ConveyorAuto_Flow1_01.FlowChart_Run();
			ConveyorAuto_Flow2_01.FlowChart_Run();
			ConveyorAuto_Flow3_01.FlowChart_Run();
		}
		public override void StopRun()
		{

		}
		/// <summary>
		/// Interactive signal 
		/// </summary>
		public bool BufferConveyorReady = false;
		public bool WorkConveyorReady = false;
		public bool UpConveyorProductReady = false;
		private NPFlowChart.Flow_Chart.ResultType ConveyAuto_Flow2_24_FlowChartRun()
		{
			return SysPara.bByPass ? NPFlowChart.Flow_Chart.ResultType.CASE1 : NPFlowChart.Flow_Chart.ResultType.NEXT;
		}
		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_01_FlowChartRun()
		{
			MiddleLayer.HomeF.AddRunMessage("Conveyor Initial Flow Start");
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_02_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_UpConveyor_Buffer_ConveyorForward.Off();
			MiddleLayer.ManualF.OB_UpConveyor_Buffer_ConveyorReverse.Off();
			MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + ConveyInit_Flow1_3.text);
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_03_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_UpConveyor_Work_ConveyorForward.Off();
			MiddleLayer.ManualF.OB_UpConveyor_Work_ConveyorReverse.Off();
			MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + ConveyInit_Flow1_4.text);
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_04_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_DownConveyor_Reverse.Off();
			MiddleLayer.ManualF.OB_DownConveyor_Forward.Off();
			MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + ConveyInit_Flow1_5.text);
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyAuto_Flow1_01_FlowChartRun()
		{
			MiddleLayer.HomeF.AddRunMessage("Conveyor Auto:" + ConveyorAuto_Flow1_01.text);
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_11_FlowChartRun()
		{
			SysPara.ConveyorInitialOk = true;
			MiddleLayer.HomeF.AddRunMessage("Conveyor Initial Flow End");
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_05_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_UpConveyor_Buffer_Stop_Cylinder.On();
			bool r = MiddleLayer.ManualF.IB_UpConveyor_Buffer_StopUp_Sensor.On();
			if (r)
			{

				MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + ConveyInit_Flow1_6.text);
				return NPFlowChart.Flow_Chart.ResultType.NEXT;
			}
			if (ConveyInit_Flow1_6.FlowChart_ElapsedMilliseconds > 5000)
			{

				MiddleLayer.HomeF.AddErrorLog("Alarm:" + MiddleLayer.HomeF.GetAlarmConent("1") + "- " + "Position:" + "ConveyInit_Flow1_05");
				NPSDK.Alarm.Show("1");
			}
			return NPFlowChart.Flow_Chart.ResultType.IDLE;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_06_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_UpConveyor_Work_Jacking_Cylinder.Off();
			bool r = MiddleLayer.ManualF.IB_UpConveyor_Work_JackingDown_Sensor.On();
			if (r)
			{
				MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + ConveyInit_Flow1_7.text);

				return NPFlowChart.Flow_Chart.ResultType.NEXT;
			}

			if (ConveyInit_Flow1_7.FlowChart_ElapsedMilliseconds > 5000)
			{
				MiddleLayer.HomeF.AddErrorLog("Alarm:" + MiddleLayer.HomeF.GetAlarmConent("2") + "- " + "Position:" + "ConveyInit_Flow1_06");
				NPSDK.Alarm.Show("2");

			}
			return NPFlowChart.Flow_Chart.ResultType.IDLE;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_07_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_UpConveyor_Work_Stop_Cylinder.On();

			bool r = MiddleLayer.ManualF.IB_UpConveyor_Work_StopUp_Sensor.On();
			if (r)
			{
				MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + ConveyInit_Flow1_8.text);
				return NPFlowChart.Flow_Chart.ResultType.NEXT;

			}

			if (ConveyInit_Flow1_8.FlowChart_ElapsedMilliseconds > 5000)
			{
				MiddleLayer.HomeF.AddErrorLog("Alarm:" + MiddleLayer.HomeF.GetAlarmConent("3") + "- " + "Position:" + "ConveyInit_Flow1_07");
				NPSDK.Alarm.Show("3");

			}
			return NPFlowChart.Flow_Chart.ResultType.IDLE;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_08_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_DownConveyor_Stop_Cylinder.On();
			bool r = MiddleLayer.ManualF.IB_DownConveyor_StopUp_Sensor.On();
			if (r)
			{
				MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + ConveyInit_Flow1_9.text);
				return NPFlowChart.Flow_Chart.ResultType.NEXT;
			}
			if (ConveyInit_Flow1_9.FlowChart_ElapsedMilliseconds > 5000)
