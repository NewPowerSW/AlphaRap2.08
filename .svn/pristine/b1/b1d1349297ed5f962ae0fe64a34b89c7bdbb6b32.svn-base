				MiddleLayer.HomeF.AddErrorLog("Alarm:" + MiddleLayer.HomeF.GetAlarmConent("4") + "- " + "Position:" + "ConveyInit_Flow1_08");
				NPSDK.Alarm.Show("4");
			}
			return NPFlowChart.Flow_Chart.ResultType.IDLE;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_09_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_UpConveyor_Buffer_ConveyorForward.On();
			MiddleLayer.ManualF.OB_UpConveyor_Work_ConveyorForward.On();
			MiddleLayer.ManualF.OB_DownConveyor_Forward.On();
			MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + ConveyInit_Flow2_1.text);
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyInit_Flow1_10_FlowChartRun()
		{
			if (ConveyInit_Flow2_2.FlowChart_ElapsedMilliseconds > 3000)
			{
				MiddleLayer.ManualF.OB_UpConveyor_Buffer_ConveyorForward.Off();
				MiddleLayer.ManualF.OB_UpConveyor_Work_ConveyorForward.Off();
				MiddleLayer.ManualF.OB_DownConveyor_Forward.Off();
				MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + ConveyInit_Flow2_2.text);
				return NPFlowChart.Flow_Chart.ResultType.NEXT;
			}
			return NPFlowChart.Flow_Chart.ResultType.IDLE;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyAuto_Flow1_02_FlowChartRun()
		{

			if (!MiddleLayer.ManualF.IB_UpConveyor_Buffer_BoardStop_Sensor.On())
			{
				MiddleLayer.HomeF.AddRunMessage("Conveyor Auto:" + ConveyorAuto_Flow1_02.text);
				return NPFlowChart.Flow_Chart.ResultType.NEXT;
			}
			return NPFlowChart.Flow_Chart.ResultType.CASE1;
		}

		private NPFlowChart.Flow_Chart.ResultType ConveyAuto_Flow1_04_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_UpConveyor_Buffer_Stop_Cylinder.On();

			bool Buffer_StopUp_Sensor_Staus = MiddleLayer.ManualF.IB_UpConveyor_Buffer_StopUp_Sensor.On();
			if (Buffer_StopUp_Sensor_Staus)
			{
				MiddleLayer.HomeF.AddRunMessage("Conveyor Auto:" + ConveyorAuto_Flow1_04.text);
				return NPFlowChart.Flow_Chart.ResultType.NEXT;
			}
			if (ConveyorAuto_Flow1_04.FlowChart_ElapsedMilliseconds > 5000)
			{
				NPSDK.Alarm.Show("1");
				MiddleLayer.HomeF.AddErrorLog("Alarm:" + MiddleLayer.HomeF.GetAlarmConent("1") + "- " + "Position:" + "ConveyAuto_Flow1_04");

			}
			return NPFlowChart.Flow_Chart.ResultType.IDLE;

		}

