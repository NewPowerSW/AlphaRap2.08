        {
           
            double a= (Vision2HeadDataList[0].X- Vision2HeadDataList[1].X)/(Math.Sin(Vision2HeadDataList[0].MotorR)- Math.Sin(Vision2HeadDataList[1].MotorR));
            double a2 = (Vision2HeadDataList[0].Y - Vision2HeadDataList[1].Y) / (Math.Cos(Vision2HeadDataList[0].MotorR) - Math.Cos(Vision2HeadDataList[1].MotorR));

            double Radian=0;
            return Radian;
        }

