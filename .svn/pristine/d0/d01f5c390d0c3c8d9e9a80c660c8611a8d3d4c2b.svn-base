        public void Manual_GotoXYZR(double XPos, double YPos, double ZPos, double RPos)
        {
            int ManualGotoIndex = 0;
            while (!StopManualTask.IsCancellationRequested)
            {
                switch (ManualGotoIndex)
                {
                    case 0:

                        ManualGotoIndex++;



                        break;
                    case 1://Z轴回安全位

