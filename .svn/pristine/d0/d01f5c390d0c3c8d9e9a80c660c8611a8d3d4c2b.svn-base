            y[1] = Vision2HeadDataList[1].Y;
            y[2] = Vision2HeadDataList[2].Y;
            y[3] = Vision2HeadDataList[3].Y;
            y[4] = Vision2HeadDataList[4].Y;
            double offsetX = 0;
            double offsetY = 0;
            double offsetR = 0;

            CalculateOffset(3, Vision2HeadDataList[11].X, Vision2HeadDataList[11].Y, Vision2HeadDataList[11].R, ref offsetX,ref offsetY,ref offsetR);
        }


        public CogToolBlock TB;
        public void CalculateOffset(int Head,double SnapX, double SnapY, double SnapR,ref double offsetX, ref double offsetY, ref double OffsetAngle)
        {
            double CenterX = 0;
            double CenterY = 0;
            double CenterRadius = 0;
            int length = 5;
           
            Cognex.VisionPro.CogFitCircleTool FitCircle = H2_VFiducial.TB.Tools["CogFitCircleTool1"] as Cognex.VisionPro.CogFitCircleTool;
            FitCircle.RunParams.NumPoints = 5;
            FitCircle.RunParams.NumToIgnore = 0;
            for (int i = (Head-1)*5; i < length + (Head - 1) * 5; i++)
            {
                FitCircle.RunParams.SetPoint(i- (Head - 1) * 5, Vision2HeadDataList[i].X, Vision2HeadDataList[i].Y);


            }
            FitCircle.Run();

            while(!(FitCircle.RunStatus.Result == Cognex.VisionPro.CogToolResultConstants.Accept))
                {
                  string a = FitCircle.RunStatus.Message;

                }


            CenterX = FitCircle.Result.GetCircle().CenterX;
            CenterY = FitCircle.Result.GetCircle().CenterY;
            CenterRadius = FitCircle.Result.GetCircle().Radius;

            //double RotateAngle1 = 12.453 * Math.PI / 180;
            double OrgAngle = Math.Tanh((DownVisionPickDataList[Head - 1].Y- CenterY) / (DownVisionPickDataList[Head - 1].X - CenterX)) * 180 / Math.PI;
            double RotateAngle1=0;
            RotateAngle1 = (OrgAngle) * Math.PI / 180;


            double RotateAngle2=0;
           if (Head==1)
            {
                
                OffsetAngle = DownVisionPickDataList[Head - 1].R - SnapR;
                RotateAngle2 = (OrgAngle + (OffsetAngle)) * Math.PI / 180;
                double bbb = CenterX + CenterRadius * Math.Cos(RotateAngle2);
                offsetX =  CenterRadius * Math.Cos(RotateAngle2) - CenterRadius * Math.Cos(RotateAngle1) + SnapX - DownVisionPickDataList[Head - 1].X;
                offsetY =  CenterRadius * Math.Sin(RotateAngle2) - CenterRadius * Math.Sin(RotateAngle1) + SnapY - DownVisionPickDataList[Head - 1].Y;
                offsetX = -offsetX;
                offsetY = -offsetY;
            }
            if ( Head == 3)
            {
                OffsetAngle = DownVisionPickDataList[Head - 1].R - SnapR;
                RotateAngle2 = (OrgAngle - (OffsetAngle)) * Math.PI / 180;
                offsetX = CenterRadius * Math.Cos(RotateAngle2) - CenterRadius * Math.Cos(RotateAngle1) + SnapX - DownVisionPickDataList[Head - 1].X;
                offsetY = CenterRadius * Math.Sin(RotateAngle2) - CenterRadius * Math.Sin(RotateAngle1) + SnapY - DownVisionPickDataList[Head - 1].Y;
                offsetX = -offsetX;
                offsetY = -offsetY;

            }

            if (Head == 2 )
            {
                OffsetAngle = DownVisionPickDataList[Head - 1].R - SnapR;
                RotateAngle2 = (OrgAngle - (OffsetAngle)) * Math.PI / 180;
                offsetX = CenterRadius * Math.Cos(RotateAngle1) - CenterRadius * Math.Cos(RotateAngle2)  + SnapX - DownVisionPickDataList[Head - 1].X;
                offsetY = CenterRadius * Math.Sin(RotateAngle1) - CenterRadius * Math.Sin(RotateAngle2)  + SnapY - DownVisionPickDataList[Head - 1].Y;

            

            }

            if ( Head == 4)
            {
                OffsetAngle = DownVisionPickDataList[Head - 1].R - SnapR;
                RotateAngle2 = (OrgAngle - (OffsetAngle)) * Math.PI / 180;
                offsetX = CenterRadius * Math.Cos(RotateAngle1) - CenterRadius * Math.Cos(RotateAngle2) + SnapX - DownVisionPickDataList[Head - 1].X;
                offsetY = CenterRadius * Math.Sin(RotateAngle1) - CenterRadius * Math.Sin(RotateAngle2) + SnapY - DownVisionPickDataList[Head - 1].Y;

                offsetX = -offsetX;
                offsetY = -offsetY;

            }
            double CC = CenterRadius * Math.Sin(RotateAngle2);

        }


        public Pos4D VisionCalculateOffset(int Head, double OreSnapR, double SnapR)
        {
            Pos4D OffsetPos=new Pos4D();

            double OffsetX=0;
            double OffsetY=0;
            double OffsetR=0;

            if (Head == 1)
            {
                double Ag1 = UpVisionPickDataList[2].R * Math.PI / 180;
                double Ag2 = UpVisionPickDataList[3].R * Math.PI / 180;
                double RadiusX = (UpVisionPickDataList[2].X - UpVisionPickDataList[3].X) / (Math.Cos(Ag1) - Math.Cos(Ag2));
                double RadiusY = (UpVisionPickDataList[2].Y - UpVisionPickDataList[3].Y) / (Math.Sin(Ag1) - Math.Sin(Ag2));

                double bg1 = OreSnapR * Math.PI / 180;
                double bg2 = SnapR * Math.PI / 180;

                 OffsetX = RadiusX * Math.Cos(bg1) - RadiusX * Math.Cos(bg2);
                 OffsetY = RadiusY * Math.Sin(bg1) - RadiusY * Math.Sin(bg2);
                 OffsetR = OreSnapR - SnapR;

                 OffsetPos.x = OffsetX;
                 OffsetPos.y = OffsetY;
                 OffsetPos.u = OffsetR;
            }
            if (Head == 2)
            {
                double Ag1 = UpVisionPickDataList[4].R * Math.PI / 180;
                double Ag2 = UpVisionPickDataList[5].R * Math.PI / 180;

                double RadiusX = (UpVisionPickDataList[4].X - UpVisionPickDataList[5].X) / (Math.Cos(Ag1) - Math.Cos(Ag2));

                double RadiusY = (UpVisionPickDataList[4].Y - UpVisionPickDataList[5].Y) / (Math.Sin(Ag1) - Math.Sin(Ag2));


                double bg1 = OreSnapR * Math.PI / 180;
                double bg2 = SnapR * Math.PI / 180;

                OffsetX = RadiusX * Math.Cos(bg1) - RadiusX * Math.Cos(bg2);
                OffsetY = RadiusY * Math.Sin(bg1) - RadiusY * Math.Sin(bg2);
                OffsetR = OreSnapR - SnapR;

                OffsetPos.x = OffsetX;
                OffsetPos.y = OffsetY;
                OffsetPos.u = OffsetR;


            }

            return OffsetPos;

        }



