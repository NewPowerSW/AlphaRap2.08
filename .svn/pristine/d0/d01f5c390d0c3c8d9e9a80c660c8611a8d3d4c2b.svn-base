        private void button1_Click(object sender, EventArgs e)
        {
            double H1_X = 0;
            double H1_Y = 0;
            double Centre = 10;
            try
            {
                switch (RecyclingCenter)
                {
                    case 1:
                        H1_X = GetRecipeValue("Pset", "H1_Fiducial_2_X");
                        H1_Y = GetRecipeValue("Pset", "H1_Fiducial_2_Y");
                        NineTimes++;
                        break;
                    case 2:
                        H1_X = GetRecipeValue("Pset", "H1_Fiducial_2_X") - Centre;
                        H1_Y = GetRecipeValue("Pset", "H1_Fiducial_2_Y");
                        NineTimes++;
                        break;
                    case 3:
                        H1_X = GetRecipeValue("Pset", "H1_Fiducial_2_X") - Centre;
                        H1_Y = GetRecipeValue("Pset", "H1_Fiducial_2_Y") - Centre;
                        NineTimes++;
                        break;
                    case 4:
                        H1_X = GetRecipeValue("Pset", "H1_Fiducial_2_X");
                        H1_Y = GetRecipeValue("Pset", "H1_Fiducial_2_Y") - Centre;
                        NineTimes++;
                        break;
                    case 5:
                        H1_X = GetRecipeValue("Pset", "H1_Fiducial_2_X") + Centre;
                        H1_Y = GetRecipeValue("Pset", "H1_Fiducial_2_Y") - Centre;
                        NineTimes++;
                        break;
                    case 6:
                        H1_X = GetRecipeValue("Pset", "H1_Fiducial_2_X") + Centre;
                        H1_Y = GetRecipeValue("Pset", "H1_Fiducial_2_Y");
                        NineTimes++;
                        break;
                    case 7:
                        H1_X = GetRecipeValue("Pset", "H1_Fiducial_2_X") + Centre;
                        H1_Y = GetRecipeValue("Pset", "H1_Fiducial_2_Y") + Centre;
                        NineTimes++;
                        break;
                    case 8:
                        H1_X = GetRecipeValue("Pset", "H1_Fiducial_2_X");
                        H1_Y = GetRecipeValue("Pset", "H1_Fiducial_2_Y") + Centre;
                        NineTimes++;
                        break;
                    case 9:
                        H1_X = GetRecipeValue("Pset", "H1_Fiducial_2_X") - Centre;
                        H1_Y = GetRecipeValue("Pset", "H1_Fiducial_2_Y") + Centre;
                        NineTimes++;
                        break;
                }
                bool r1 = Manual_GotoXYZ(H1_X, H1_Y, GetRecipeValue("Pset", "H1_WP1_Fiducial_Z"));
                if (r1)
                {
                    PhotoGraph(); //拍照
                    Thread.Sleep(500);
                    Add_MPoint(); //设置点位
                    Thread.Sleep(500);
                    if (NineTimes == 9)
                    {
                        SetUpTheData(); //设置九点
                        Thread.Sleep(500);
                        RecyclingCenter = 0;
                    }
                }
            }
            catch (Exception a)
            {
                MessageBox.Show(a.Message.ToString());
            }
        }

