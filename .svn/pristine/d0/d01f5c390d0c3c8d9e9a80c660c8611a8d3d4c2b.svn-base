                        //    ManualGotoIndex++;

                        //}

                        break;

                    case 2://X轴回安全位

                        ManualGotoIndex++;

                        break;
                    case 3://先转R轴

                        ManualGotoIndex++;

                        break;
                    case 4://转XY轴
                        //bool r1 = MiddleLayer.HardF.MTR_H1_X.Goto(XPos);
                        //bool r2 = MiddleLayer.HardF.MTR_H1_Y.Goto(YPos);
                        //bool r3 = MiddleLayer.HardF.MTR_H1_U.Goto(RPos);
                        //if (r1 && r2 && r3)
                        //{
                        //    ManualGotoIndex++;
                        //}
                        break;
                    case 5://转Z轴
                        //bool z1 = MiddleLayer.HardF.MTR_H1_Z.Goto(ZPos);
                        //if (z1)
                        //{
                        //    ManualGotoIndex++;
                        //}

                        break;
                    case 6:

                        return;
                }
                Thread.Sleep(1);
            }
        }

