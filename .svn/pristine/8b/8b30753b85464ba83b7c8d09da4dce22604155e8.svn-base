using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace AlphaRap.MenuForm
{
    public partial class LockForm1 : Form
    {
        public LockForm1()
        {
            InitializeComponent();
        }

        public string password1;
        public string password2;

        private void button1_Click(object sender, EventArgs e)
        {

            if (button1.Text == "Log In" )
            {
                password1 = textBox1.Text;
                textBox1.Clear();
                button1.Text = "Log Out";
                groupBox1.Visible = false;

                groupBox2.Visible = true;
            }
            else if (button1.Text == "登入")
            {
                password1 = textBox1.Text;
                textBox1.Clear();
                button1.Text = "登出";
                groupBox1.Visible = false;

                groupBox2.Visible = true;
            }
            else if (button1.Text == "Log Out")
            {
                password2 = textBox1.Text;
                textBox1.Clear();
                if (password1 == password2)
                {

                    button1.Text = "Log In";
                    this.Close();
                }

            }
            else if(button1.Text == "登出")
            {
                password2 = textBox1.Text;
                textBox1.Clear();
                if (password1 == password2)
                {

                    button1.Text = "登入";
                    this.Close();
                }

            }
        }

        private void button2_Click(object sender, EventArgs e)
        {
            if (button1.Text == "Log In"|| button1.Text == "登入")
            {
                this.Close();
            }
            else
            {
                groupBox1.Visible = false;
                groupBox2.Visible = true;
            }
        }

        private void button3_Click(object sender, EventArgs e)
        {
            groupBox2.Visible = false;
            groupBox1.Visible = true;
        }

        public void LanguageChange(LanguageType LangLanguage = LanguageType.English)
        {
            if (LangLanguage == LanguageType.Chinese)
            {
                label1.Text = "密碼:";
                label2.Text= "警告！！！";
                label3.Text = "鎖屏模式";
                label4.Text = "不要觸碰";
                button1.Text = "登入";
                button2.Text = "取消";
                button3.Text = "關閉鎖屏模式";
                groupBox1.Text = "鎖屏登錄";
            }
            else
            {
                label1.Text = "PassWord:";
                label2.Text = "Warning！！！";
                label3.Text = "LOTO Mode";
                label4.Text = "DO NOT TOUCH";
                button1.Text = "Log In";
                button2.Text = "Cancel";
                button3.Text = "LOTO OFF";
                groupBox1.Text = "Loto Login"; 
            }
        }
    }
}
