using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace AlphaRap.TaskProcess
{
	public partial class DownConveryor : NPFlowChart.Flow_BaseForm
	{
		public DownConveryor()
		{

			CheckForIllegalCrossThreadCalls = false;
			InitializeComponent();
		}
		public override void Initial()
		{
			DownConveyInit_Flow1_1.FlowChart_Run();

		}
		public override void PauseRun()
		{

		}
		public override void StartRun()
		{
			DownConveyorAuto_Flow1_1.FlowChart_Run(false, true);
		}
		public override void StopRun()
		{

		}
		
		private NPFlowChart.Flow_Chart.ResultType DownConveyInit_Flow1_1_FlowChartRun()
		{

			SysPara.DownConveyorInitialOk = false;
			MiddleLayer.HomeF.AddRunMessage("DownConveyor Initial Flow Start");
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType DownConveyInit_Flow1_2_FlowChartRun()
		{

			MiddleLayer.ManualF.OB_DownConveyor_Reverse.Off();
			MiddleLayer.ManualF.OB_DownConveyor_Forward.Off();
			MiddleLayer.HomeF.AddRunMessage("DownConveyorInit:" + DownConveyInit_Flow1_2.text);
			return NPFlowChart.Flow_Chart.ResultType.NEXT;

		}

		private NPFlowChart.Flow_Chart.ResultType DownConveyInit_Flow1_3_FlowChartRun()
		{

			MiddleLayer.ManualF.OB_DownConveyor_Stop_Cylinder.On();
			bool r = MiddleLayer.ManualF.IB_DownConveyor_StopUp_Sensor.On();
			if (r)
			{
				MiddleLayer.HomeF.AddRunMessage("ConveyInit:" + DownConveyInit_Flow1_3.text);
				return NPFlowChart.Flow_Chart.ResultType.NEXT;
			}
			if (DownConveyInit_Flow1_3.FlowChart_ElapsedMilliseconds > 5000)
			{
				MiddleLayer.HomeF.AddErrorLog("Alarm:" + MiddleLayer.HomeF.GetAlarmConent("4") + "- " + "Position:" + DownConveyInit_Flow1_3.text);
				NPSDK.Alarm.Show("4");
			}
			return NPFlowChart.Flow_Chart.ResultType.IDLE;

		}

		private NPFlowChart.Flow_Chart.ResultType DownConveyInit_Flow1_4_FlowChartRun()
		{
			MiddleLayer.ManualF.OB_DownConveyor_Forward.On();
			MiddleLayer.HomeF.AddRunMessage("DownConveyInit:" + DownConveyInit_Flow1_4.text);
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType DownConveyInit_Flow1_5_FlowChartRun()
		{
			if (DownConveyInit_Flow1_5.FlowChart_ElapsedMilliseconds > 3000)
			{

				MiddleLayer.ManualF.OB_DownConveyor_Forward.Off();
				MiddleLayer.HomeF.AddRunMessage("DownConveyInit:" + DownConveyInit_Flow1_5.text);
				return NPFlowChart.Flow_Chart.ResultType.NEXT;
			}
			return NPFlowChart.Flow_Chart.ResultType.IDLE;
		}

		private NPFlowChart.Flow_Chart.ResultType DownConveyInit_Flow1_6_FlowChartRun()
		{
			MiddleLayer.HomeF.AddRunMessage("DownConveyInit:" + DownConveyInit_Flow1_6.text);
			SysPara.DownConveyorInitialOk = true;
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType DownConveyorAuto_Flow1_1_FlowChartRun()
		{
			MiddleLayer.HomeF.AddRunMessage("DownConveyorAuto:" + DownConveyorAuto_Flow1_1.text);
			return NPFlowChart.Flow_Chart.ResultType.NEXT;
		}

		private NPFlowChart.Flow_Chart.ResultType DownConveyorAuto_Flow1_2_FlowChartRun()
		{
			bool r = MiddleLayer.ManualF.IB_DownConveyor_BoardStop_Sensor.On();
			MiddleLayer.HomeF.AddRunMessage("DownConveyorAuto:" + DownConveyorAuto_Flow1_2.text);
			if (!r)
			{
				return NPFlowChart.Flow_Chart.ResultType.NEXT;
			}
			return NPFlowChart.Flow_Chart.ResultType.CASE1;
		}

